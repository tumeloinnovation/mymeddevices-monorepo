# MyMedDevices Backend Environment Variables

# ============================================================================
# SECURITY - MUST BE SET IN PRODUCTION
# ============================================================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=j546XyPJMtDBh3XobM7DceZjNYyzJ-jFVQKVyI2I7Ms

# ============================================================================
# JWT TOKEN SETTINGS
# ============================================================================
# JWT Algorithm (default: RS256)
ALGORITHM=RS256

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# DATABASE
# ============================================================================
# Database URL (default: sqlite+aiosqlite:///./mymeddevices.db)
DATABASE_URL=postgresql+asyncpg://nickm@localhost/mymeddevices

# ============================================================================
# CORS SETTINGS
# ============================================================================
# Additional allowed origins (localhost:3000-3002 are already allowed)
# ADDITIONAL_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ============================================================================
# REDIS (Rate Limiting)
# ============================================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# SMS SETTINGS (HOSTPINNACLE)
# ============================================================================

# ============================================================================
# EMAIL
# ============================================================================
EMAIL_LOGO_URL=https://mymeddevices.com/wp-content/uploads/2022/11/cropped-170by50-1.png
FROM_EMAIL=MyMedDevices <noreply@mymeddevices.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

