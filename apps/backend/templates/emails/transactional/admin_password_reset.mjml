<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="36px 32px 12px" background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="h1">Your Password Has Been Reset</mj-text>
        <mj-text>Hi {{ user_name }}, an administrator has reset your MyMedDevices account password.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 32px" background-color="#ffffff">
      <mj-column background-color="#fef3c7" border="1px solid #fbbf24" border-radius="8px" padding="20px">
        <mj-text padding="0" font-size="14px" color="#92400e">
          {% if force_change %}
          <strong>Important:</strong> You will be required to change your password the next time you log in.
          {% else %}
          <strong>Note:</strong> Your password has been updated. You can use the new password to log in.
          {% endif %}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="28px 32px 0" background-color="#ffffff">
      <mj-column background-color="#eff6ff" border="1px solid #bfdbfe" border-radius="8px" padding="16px 20px">
        <mj-text font-size="14px" color="#1e40af" padding="0">
          If you requested this change or were notified by your administrator, no further action is required at this time.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="28px 32px 0" background-color="#ffffff">
      <mj-column background-color="#fef2f2" border="1px solid #fecaca" border-radius="8px" padding="16px 20px">
        <mj-text font-size="14px" color="#991b1b" padding="0">
          If you did <strong>not</strong> expect this change, please contact our support team immediately.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 32px 24px" background-color="#ffffff">
      <mj-column>
        <mj-button href="{{ login_url }}">
          Log In to Your Account
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
