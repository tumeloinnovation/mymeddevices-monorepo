<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />

    <!-- Status Banner & Title -->
    <mj-section padding="32px 32px 12px" background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="h1" color="#991b1b">Application Status Update</mj-text>
        <mj-text font-size="18px" color="#991b1b" font-weight="600" padding-top="8px">
          Action Required for {{ company_name }}
        </mj-text>
        <mj-text padding-top="12px">
          Dear {{ user_name }},
        </mj-text>
        <mj-text>
          Thank you for your interest in joining the <strong>MyMedDevices</strong> medical device marketplace. Following a review of your application by our compliance team, we regret to inform you that your vendor account application for <strong>{{ company_name }}</strong> was not approved at this time.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Rejection Reason Callout Box -->
    <mj-section padding="0 32px 20px" background-color="#ffffff">
      <mj-column background-color="#fef2f2" border="1px solid #fecaca" border-radius="8px" padding="20px">
        <mj-text font-size="15px" font-weight="700" color="#991b1b" padding="0 0 8px">
          Reason for Decision:
        </mj-text>
        <mj-text font-size="14px" color="#7f1d1d" line-height="1.6" padding="0">
          {{ rejection_reason }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Interactive Resubmission CTA Button -->
    <mj-section padding="10px 32px 24px" background-color="#ffffff">
      <mj-column>
        <mj-button href="{{ resubmit_url }}" background-color="#053D7A">
          Update &amp; Resubmit Application
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Verification Checklist & Requirements -->
    <mj-section padding="0 32px 24px" background-color="#ffffff">
      <mj-column background-color="#f8fafc" border-radius="8px" padding="24px">
        <mj-text font-size="16px" font-weight="700" color="#053D7A" padding="0 0 12px">
          Vendor Requirements Checklist
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 8px">
          To ensure a successful resubmission, please verify that your profile and documents meet the following criteria:
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 6px">
          &bull; <strong>Business Registration:</strong> Valid Certificate of Incorporation or Business Name Registration.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 6px">
          &bull; <strong>Tax Compliance:</strong> KRA PIN certificate and active tax status.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 6px">
          &bull; <strong>Regulatory Licenses:</strong> Pharmacy and Poisons Board (PPB) or KMPDB permits for restricted medical devices.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 6px">
          &bull; <strong>Identification:</strong> Clear copy of National ID or Passport of the registered director/authorized representative.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="6px 0 0">
          &bull; <strong>Bank &amp; Payment Details:</strong> Matching account names for M-Pesa Business Till/Paybill or Corporate Bank Account.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Help & Appeals Box -->
    <mj-section padding="0 32px 24px" background-color="#ffffff">
      <mj-column border="1px solid #e2e8f0" border-radius="8px" padding="20px">
        <mj-text font-size="15px" font-weight="700" color="#053D7A" padding="0 0 8px">
          Need Assistance or Have Questions?
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 8px">
          If you believe this decision was made in error or if you need clarification regarding required documentation, our Compliance &amp; Vendor Support Team is ready to help:
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 4px">
          &bull; Email: <a href="mailto:{{ support_email }}" style="color: #053D7A; font-weight: 600;">{{ support_email }}</a>
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 8px">
          &bull; Hours: Monday &ndash; Friday, 8:00 AM &ndash; 5:00 PM EAT
        </mj-text>
        <mj-text font-size="13px" color="#64748b" padding="6px 0 0">
          Note: Once resubmitted with updated information, applications are typically reviewed within 24&ndash;48 business hours.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
