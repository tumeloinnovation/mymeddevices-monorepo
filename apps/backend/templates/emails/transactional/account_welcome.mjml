<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
    <mj-style inline="inline">
      .step-number {
        background-color: #053D7A;
        color: #ffffff;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: inline-block;
        text-align: center;
        line-height: 24px;
        font-size: 12px;
        font-weight: 700;
      }
      .link-fallback {
        color: #053D7A;
        word-break: break-all;
        font-size: 13px;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />
    
    <!-- Hero Section -->
    <mj-section padding="32px 32px 16px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="12px" font-weight="700" color="#EF6C24" text-transform="uppercase" letter-spacing="1px" padding="0 0 8px">
          Healthcare Procurement &amp; Operations
        </mj-text>
        <mj-text mj-class="h1" padding="0 0 12px">
          Welcome to MyMedDevices
        </mj-text>
        <mj-text font-size="15px" color="#334155" line-height="1.6" padding="0">
          Hi <strong>{{ user_name }}</strong>, your account has been created successfully. We're excited to have you on board!
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Account Details Card -->
    <mj-section padding="8px 32px 16px" background-color="#ffffff">
      <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="10px" padding="18px 20px">
        <mj-text font-size="13px" font-weight="700" color="#053D7A" text-transform="uppercase" letter-spacing="0.5px" padding="0 0 10px">
          Account Overview
        </mj-text>
        {% if user_email %}
        <mj-text font-size="14px" color="#475569" padding="2px 0">
          <strong style="color: #1e293b;">Email Address:</strong> {{ user_email }}
        </mj-text>
        {% endif %}
        {% if role %}
        <mj-text font-size="14px" color="#475569" padding="2px 0">
          <strong style="color: #1e293b;">Assigned Role:</strong> {{ role }}
        </mj-text>
        {% endif %}
        {% if account_id and account_id != 'None' and account_id != 'none' %}
        <mj-text font-size="14px" color="#475569" padding="2px 0">
          <strong style="color: #1e293b;">Account ID:</strong> {{ account_id }}
        </mj-text>
        {% endif %}
        {% if temp_password %}
        <mj-text font-size="14px" color="#475569" padding="2px 0">
          <strong style="color: #1e293b;">Temporary Password:</strong> <code style="background-color: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-weight: 600; color: #0f172a;">{{ temp_password }}</code>
        </mj-text>
        {% endif %}
      </mj-column>
    </mj-section>

    <!-- Next Steps Section -->
    <mj-section padding="8px 32px 20px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="14px" font-weight="700" color="#1e293b" padding="0 0 12px">
          Quick Start Guide
        </mj-text>
        
        <mj-text font-size="14px" color="#475569" line-height="1.5" padding="4px 0">
          <strong>1. Verify Your Account</strong> — Click the button below to confirm your email and activate your access.
        </mj-text>
        <mj-text font-size="14px" color="#475569" line-height="1.5" padding="4px 0">
          <strong>2. Complete Your Profile</strong> — Set a secure permanent password and customize your notification preferences.
        </mj-text>
        <mj-text font-size="14px" color="#475569" line-height="1.5" padding="4px 0">
          <strong>3. Start Operations</strong> — Access certified medical devices, manage orders, and view delivery updates.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- CTA Section -->
    <mj-section padding="12px 32px 28px" background-color="#ffffff">
      <mj-column>
        <mj-button href="{{ verify_url }}" background-color="#EF6C24" color="#ffffff" font-size="16px" font-weight="600" border-radius="8px" padding="14px 32px">
          Verify &amp; Complete Profile
        </mj-button>
        <mj-text font-size="12px" color="#94a3b8" align="center" padding="16px 0 0">
          If the button doesn't work, copy and paste this link into your browser:<br/>
          <a href="{{ verify_url }}" class="link-fallback">{{ verify_url }}</a>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Security Assurance Note -->
    <mj-section padding="0 32px 24px" background-color="#ffffff">
      <mj-column background-color="#f1f5f9" border-radius="8px" padding="12px 16px">
        <mj-text font-size="12px" color="#64748b" line-height="1.5" padding="0">
          <strong>Need help?</strong> Contact our support team at <a href="mailto:support@mymeddevices.com" style="color: #053D7A; text-decoration: underline;">support@mymeddevices.com</a>. If you did not create or expect this account, please ignore this email or reach out to us immediately.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
