<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />

    <!-- Status Banner & Title -->
    <mj-section padding="32px 32px 12px" background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="h1" color="#b45309">Account Suspension Notice</mj-text>
        <mj-text font-size="18px" color="#b45309" font-weight="600" padding-top="8px">
          Urgent Update for {{ company_name }}
        </mj-text>
        <mj-text padding-top="12px">
          Dear {{ user_name }},
        </mj-text>
        <mj-text>
          This is an official notification that your vendor store account for <strong>{{ company_name }}</strong> on <strong>MyMedDevices</strong> has been temporarily suspended by our compliance team.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Suspension Reason Callout Box -->
    <mj-section padding="0 32px 20px" background-color="#ffffff">
      <mj-column background-color="#fef3c7" border="1px solid #fde68a" border-radius="8px" padding="20px">
        <mj-text font-size="15px" font-weight="700" color="#92400e" padding="0 0 8px">
          Reason for Suspension:
        </mj-text>
        <mj-text font-size="14px" color="#78350f" line-height="1.6" padding="0">
          {{ suspension_reason }}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Impact on Account -->
    <mj-section padding="0 32px 20px" background-color="#ffffff">
      <mj-column background-color="#f8fafc" border-radius="8px" padding="24px">
        <mj-text font-size="16px" font-weight="700" color="#053D7A" padding="0 0 12px">
          What does this mean for your store?
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 8px">
          &bull; <strong>Product Listings Hidden:</strong> Your products are currently removed from search and marketplace catalog.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 8px">
          &bull; <strong>New Orders Paused:</strong> Customers cannot place new orders for your medical devices.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0 0 8px">
          &bull; <strong>Payouts Held:</strong> Pending sales payouts are temporarily paused until compliance review is completed.
        </mj-text>
        <mj-text font-size="14px" color="#334155" padding="0">
          &bull; <strong>Existing Orders:</strong> Any active in-transit orders must still be fulfilled as scheduled.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Action & Resolution Steps CTA -->
    <mj-section padding="10px 32px 24px" background-color="#ffffff">
      <mj-column>
        <mj-button href="{{ support_url }}" background-color="#053D7A">
          Submit Appeal / Contact Compliance
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Support & Appeal Contact Info -->
    <mj-section padding="0 32px 24px" background-color="#ffffff">
      <mj-column border="1px solid #e2e8f0" border-radius="8px" padding="20px">
        <mj-text font-size="15px" font-weight="700" color="#053D7A" padding="0 0 8px">
          How to Reinstate Your Account
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 8px">
          To resolve this suspension, please provide the required information or documentation by contacting our Compliance Team:
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 4px">
          &bull; Email: <a href="mailto:{{ support_email }}" style="color: #053D7A; font-weight: 600;">{{ support_email }}</a>
        </mj-text>
        <mj-text font-size="14px" color="#475569" padding="0 0 8px">
          &bull; Business Hours: Monday &ndash; Friday, 8:00 AM &ndash; 5:00 PM EAT
        </mj-text>
        <mj-text font-size="13px" color="#64748b" padding="6px 0 0">
          Note: Appeals and document submissions are reviewed in order of receipt within 24&ndash;48 business hours.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
