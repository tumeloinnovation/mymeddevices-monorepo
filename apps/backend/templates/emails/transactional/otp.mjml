<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />
    
    <mj-section padding="36px 32px 12px" background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="h1">{{ title }}</mj-text>
        <mj-text>{{ lead_text }}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 32px" background-color="#ffffff">
      <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="8px" padding="28px">
        <mj-text align="center" font-family="'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace" font-size="34px" font-weight="700" letter-spacing="8px" color="#EF6C24" padding="0">
          {{ code }}
        </mj-text>
        <mj-text align="center" font-size="14px" color="#64748b" padding="10px 0 0">
          Expires in {{ expiry_minutes }} minutes
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 32px 24px" background-color="#ffffff">
      <mj-column>
        <mj-text font-size="14px" color="#64748b" padding="0">
          {{ footer_note }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
