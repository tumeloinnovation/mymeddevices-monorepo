<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />
    
    <mj-section padding="36px 32px 12px" background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="h1">Password Changed</mj-text>
        <mj-text>Hi {{ user_name }}, the password for your MyMedDevices account was successfully changed.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0 32px" background-color="#ffffff">
      <mj-column background-color="#f8fafc" border="1px solid #e2e8f0" border-radius="8px" padding="20px">
        <mj-text padding="0"><span style="font-weight: 600; color: #053D7A;">Time of change:</span> {{ change_time }}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="28px 32px 0" background-color="#ffffff">
      <mj-column background-color="#eff6ff" border="1px solid #bfdbfe" border-radius="8px" padding="16px 20px">
        <mj-text font-size="14px" color="#1e40af" padding="0">
          If you made this change, no further action is required.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="28px 32px 0" background-color="#ffffff">
      <mj-column background-color="#fef2f2" border="1px solid #fecaca" border-radius="8px" padding="16px 20px">
        <mj-text font-size="14px" color="#991b1b" padding="0">
          If you did <strong>not</strong> authorize this change,
          <a href="{{ reset_url }}" style="color: #991b1b; font-weight: 600; text-decoration: underline;">reset your password immediately</a> and contact our support team.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="24px 32px 24px" background-color="#ffffff">
      <mj-column>
        <mj-button href="{{ reset_url }}">
          Reset Password
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
