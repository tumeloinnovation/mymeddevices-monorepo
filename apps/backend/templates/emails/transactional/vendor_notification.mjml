<mjml>
  <mj-head>
    <mj-include path="../components/head.mjml" />
  </mj-head>
  <mj-body background-color="#f4f6f8">
    <mj-include path="../components/header.mjml" />
    
    <mj-section padding="36px 32px 12px" background-color="#ffffff">
      <mj-column>
        <mj-text mj-class="h1">{{ title }}</mj-text>
        <mj-text>{{ message }}</mj-text>
      </mj-column>
    </mj-section>

    {% if detail %}
    <mj-section padding="0 32px 12px" background-color="#ffffff">
      <mj-column background-color="#fef2f2" border="1px solid #fecaca" border-radius="6px" padding="16px">
        <mj-text font-size="14px" color="#991b1b" padding="0">{{ detail }}</mj-text>
      </mj-column>
    </mj-section>
    {% endif %}

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
