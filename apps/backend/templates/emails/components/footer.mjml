<mj-section padding="24px 32px" background-color="#f8fafc">
  <mj-column>
    <mj-text font-size="13px" color="#94a3b8" line-height="1.5" padding="0 0 4px">
      This is an automated message from MyMedDevices.
    </mj-text>
    <mj-text font-size="13px" color="#94a3b8" line-height="1.5" padding="0 0 4px">
