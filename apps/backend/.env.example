# MyMedDevices Backend Environment Variables

# ============================================================================
# SECURITY - MUST BE SET IN PRODUCTION
# ============================================================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-generate-with-secrets-module

# ============================================================================
# JWT TOKEN SETTINGS
# ============================================================================
# JWT Algorithm (default: RS256)
ALGORITHM=RS256

# Access token expiration in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# DATABASE
# ============================================================================
# Database URL (default: sqlite+aiosqlite:///./mymeddevices.db)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/mymeddevices

# ============================================================================
# CORS SETTINGS
# ============================================================================
# Additional allowed origins (localhost:3000-3002 are already allowed)
# ADDITIONAL_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# ============================================================================
# SMS SETTINGS (HOSTPINNACLE)
# ============================================================================

# ============================================================================
# GOOGLE GEMINI AI
# ============================================================================
# Required for AI-powered product descriptions and audit tools.
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro

# ============================================================================
# GOOGLE MAPS API
# ============================================================================
# Google Maps API Key for server-side Places validation
# Get your key from: https://console.cloud.google.com/
# Required for address validation when place_id is provided
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
