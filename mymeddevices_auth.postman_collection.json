            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"SuperSecurePassword123!\",\n  \"new_password\": \"NewSuperSecurePass456!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/change-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
