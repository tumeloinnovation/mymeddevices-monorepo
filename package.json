{
  "name": "mymeddevices-monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "cd apps/backend && PYTHONPATH=. uv run uvicorn app.main:app --reload",
    "dev:customer": "turbo dev --filter=customer",
    "dev:admin": "turbo dev --filter=admin",
    "dev:vendor": "turbo dev --filter=vendor",
    "dev:frontend": "turbo dev --filter=customer --filter=admin --filter=vendor",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.5.0",
    "@storybook/addon-interactions": "^8.5.0",
    "@storybook/addon-links": "^8.5.0",
    "@storybook/addon-themes": "^8.5.0",
    "@storybook/blocks": "^8.5.0",
    "@storybook/react": "^8.5.0",
    "@storybook/react-vite": "^8.5.0",
    "@storybook/test": "^8.5.0",
    "storybook": "^8.5.0",
    "turbo": "latest"
  },
  "packageManager": "pnpm@10.34.2"
}
